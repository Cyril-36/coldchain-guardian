# ColdChain Guardian — environment variable NAMES only.
# Never commit a real .env. Never put values, keys, tokens or account IDs here.
# Copy to .env for local use; .env is gitignored.

# ── AWS (deployment and worker) ─────────────────────────────────────────────
AWS_REGION=
# Bedrock model identifier, or the inference profile ID this account requires.
BEDROCK_MODEL_ID=

# ── Backend runtime ─────────────────────────────────────────────────────────
# Names below are the ones the code and infra/template.yaml actually use.
# NOTE: PLAN.md and docs/01-CYRIL.md call these TABLE_NAME and QUEUE_URL.
# The code is the source of truth until Cyril resolves the naming conflict.
RUNS_TABLE=
ARTIFACT_BUCKET=
INVESTIGATION_QUEUE_URL=
# Comma-separated Cognito subject IDs allowed to start runs.
ALLOWED_OPERATOR_SUBS=
BUILD_SHA=

# ── Frontend (public values only) ───────────────────────────────────────────
VITE_API_BASE_URL=
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=
